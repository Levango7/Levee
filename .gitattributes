# Normalize line endings at the repository boundary. Without this, Windows
# working copies with core.autocrlf=true materialize .go files as CRLF and
# gofmt/golangci-lint then report "not properly formatted" locally while CI
# (which sees LF in the repo and on checkout) stays green — a gate that
# cannot be reproduced on half the contributors' machines.

* text=auto

# Git meta files follow the repo convention (LF).
.gitattributes text eol=lf
.gitignore text eol=lf

# Go, shell, and text sources are always LF, in the repo AND on checkout,
# so lint results are OS-independent.
*.go text eol=lf
*.sh text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.proto text eol=lf
*.json text eol=lf
*.ts text eol=lf
*.vue text eol=lf
*.css text eol=lf
*.html text eol=lf
# Every file type the frontend build consumes must be pinned too, or a
# Windows checkout feeds the vite build CRLF bytes, its output hashes differ
# from CI's, and the dist-freshness gate below fails for reasons that look
# like nondeterminism. .svg was the live offender (public/favicon.svg is
# copied verbatim into the bundle).
*.svg text eol=lf
# Delivery artifacts processed by tools on any platform: keep them LF on
# checkout too (a CRLF install.sh is a broken shebang on Linux; unit
# files and Helm templates stay diff-clean across OSes).
*.service text eol=lf
*.tpl text eol=lf
*.txt text eol=lf
.helmignore text eol=lf

# Windows batch scripts genuinely need CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf

# Generated and binary artifacts: no eol conversion, no text diffs.
*.pb.go -text
*.pb.gw.go -text
internal/web/dist/** -text
*.png binary
*.jpg binary
*.ico binary
*.woff binary
*.woff2 binary
*.exe binary
