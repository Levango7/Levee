# LEVEE 集群节点镜像（container-lab 灾备验收用）
#
# 与 levee-lab-ssh（靶机）不同：这个镜像只装 levee 二进制本身，用来起
# master / worker 两个 serve 节点。配置与清单经 -v 挂载，密钥经环境变量
# 注入，都不进镜像。levee-linux 是 clusterdrive.py 用
# GOOS=linux CGO_ENABLED=0 go build 交叉编译出来的静态二进制。
FROM alpine:3.24
COPY levee-linux /usr/local/bin/levee
RUN chmod +x /usr/local/bin/levee
ENTRYPOINT ["levee"]
