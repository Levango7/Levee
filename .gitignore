# Binaries
/levee
/dist/
*.exe
*.exe~

# Go
vendor/

# Python tooling state: the release scripts' unit suites compile bytecode on
# every run, and an untracked __pycache__ dirties `git status` right where a
# commit is supposed to be provably clean.
__pycache__/
*.pyc


# Test
*.test
*.out
coverage.html
coverage.txt
coverage_*
coverage
zn_cov
# Ad-hoc coverage profiles named after the package they cover. Root-anchored
# on purpose: a bare `audit` pattern would also ignore internal/audit/.
/audit

# IDE
.idea/
.vscode/
*.swp
*.swo

# Agent tooling state
.zcode/
.workbuddy/

# gen-proto.sh scratch dir (cleaned up by trap, just in case)
.protoc-out.*.tmp/

# OS
.DS_Store
Thumbs.db

# Runtime
*.db
*.db-wal
*.db-shm
*.log
levee-data/

# Config (keep examples, ignore local)
configs/config.local.yaml
.env
coverfunc.txt

