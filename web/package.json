{
  "name": "levee-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "LEVEE Web UI - Vue 3 + Vite + TypeScript frontend for the LEVEE change pipeline engine",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "build:fast": "vite build",
    "preview": "vite preview",
    "type-check": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:browser": "node scripts/browser-check.mjs"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.1",
    "@fontsource-variable/ibm-plex-sans": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "axios": "^1.6.8",
    "dayjs": "^1.11.10",
    "element-plus": "^2.7.0",
    "vue": "^3.4.21",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@vitejs/plugin-vue": "^6.0.10",
    "jsdom": "^30.1.3",
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "vue-tsc": "^3.3.13"
  }
}
