{
  "agents": {
    "method": "GET",
    "path": "/agents",
    "items": [
      "active_tasks",
      "address",
      "capabilities",
      "completed_tasks",
      "failed_tasks",
      "id",
      "last_heartbeat_unix",
      "max_concurrent",
      "registered_at_unix",
      "status"
    ],
    "forbid": [
      "Id",
      "Address",
      "Capabilities",
      "Status",
      "LastHeartbeatUnix",
      "ActiveTasks",
      "CompletedTasks",
      "FailedTasks",
      "MaxConcurrent",
      "RegisteredAtUnix"
    ]
  },
  "audit-log": {
    "method": "GET",
    "path": "/audit/log",
    "keys": [
      "entries",
      "totalSize"
    ],
    "forbid": [
      "Entries",
      "NextPageToken",
      "TotalSize"
    ],
    "rows": {
      "entries": [
        "action",
        "actor",
        "currHash",
        "id",
        "prevHash",
        "runId",
        "targetHost",
        "timestamp"
      ]
    }
  },
  "audit-traces": {
    "method": "GET",
    "path": "/audit/traces",
    "keys": [
      "entries",
      "nextPageToken",
      "totalSize"
    ],
    "forbid": [
      "Entries",
      "NextPageToken",
      "TotalSize",
      "Id",
      "RunId",
      "Action",
      "TargetHost",
      "Input",
      "Output",
      "DurationMs",
      "Timestamp",
      "PrevHash",
      "CurrHash",
      "Actor",
      "Detail",
      "StoredDetail",
      "TenantId",
      "TimestampNanos"
    ],
    "rows": {
      "entries": [
        "action",
        "actor",
        "currHash",
        "detail",
        "durationMs",
        "id",
        "input",
        "output",
        "prevHash",
        "runId",
        "storedDetail",
        "targetHost",
        "timestamp"
      ]
    }
  },
  "batch-status": {
    "method": "GET",
    "path": "/system/batch-status",
    "keys": [
      "batches",
      "current_batch_no",
      "done_batches",
      "steps",
      "total_batches"
    ],
    "forbid": [
      "Batches",
      "CurrentBatchNo",
      "TotalBatches",
      "DoneBatches"
    ],
    "rows": {
      "batches": [
        "batch_no",
        "failed",
        "status",
        "succeeded",
        "total_hosts"
      ]
    }
  },
  "change": {
    "method": "GET",
    "path": "/changes/{id}",
    "keys": [
      "createdAt",
      "createdBy",
      "id",
      "label",
      "status",
      "templateName",
      "updatedAt",
      "workflowFile"
    ],
    "forbid": [
      "PlanHash",
      "TemplateName",
      "CreatedAt"
    ]
  },
  "change-trend": {
    "method": "GET",
    "path": "/system/change-trend",
    "keys": [
      "buckets",
      "series",
      "truncated"
    ],
    "forbid": [
      "Buckets",
      "Series",
      "Truncated"
    ],
    "rows": {
      "buckets": [
        "day",
        "outcomes",
        "total"
      ]
    }
  },
  "change-with-plan": {
    "method": "GET",
    "path": "/changes/{id}?includePlan=true",
    "keys": [
      "createdAt",
      "createdBy",
      "id",
      "label",
      "plan",
      "status",
      "templateName",
      "updatedAt",
      "workflowFile"
    ],
    "forbid": [
      "Plan",
      "ChangeId",
      "TargetHosts",
      "ImpactSummary",
      "MaxConcurrency"
    ],
    "objects": {
      "plan": [
        "batches",
        "changeId",
        "impactSummary",
        "targetHosts"
      ],
      "plan.batches": [
        "hosts",
        "index",
        "maxConcurrency"
      ]
    }
  },
  "changes": {
    "method": "GET",
    "path": "/changes",
    "keys": [
      "changes",
      "totalSize"
    ],
    "forbid": [
      "Changes",
      "NextPageToken",
      "TotalSize"
    ],
    "rows": {
      "changes": [
        "createdAt",
        "createdBy",
        "id",
        "label",
        "status",
        "templateName",
        "updatedAt",
        "workflowFile"
      ]
    }
  },
  "cluster-status": {
    "method": "GET",
    "path": "/system/cluster-status",
    "keys": [
      "backend",
      "cluster_enabled",
      "nodes",
      "summary"
    ],
    "forbid": [
      "Nodes",
      "Summary",
      "Backend",
      "ClusterEnabled"
    ],
    "rows": {
      "nodes": [
        "address",
        "capabilities",
        "id",
        "joined_at",
        "last_heartbeat",
        "role",
        "status"
      ]
    },
    "objects": {
      "summary": [
        "counts",
        "node_load",
        "total_active"
      ]
    }
  },
  "conversation-sessions": {
    "method": "GET",
    "path": "/conversation/sessions?user_id={user}",
    "keys": [
      "sessions"
    ],
    "forbid": [
      "Sessions",
      "UserID",
      "AlertID",
      "CreatedAt",
      "UpdatedAt"
    ],
    "rows": {
      "sessions": [
        "alert_id",
        "created_at",
        "id",
        "messages",
        "state",
        "updated_at",
        "user_id"
      ]
    }
  },
  "groups": {
    "method": "GET",
    "path": "/groups",
    "items": [
      "created_at",
      "created_at_nanos",
      "id",
      "name",
      "parent_id"
    ],
    "forbid": [
      "Id",
      "Name",
      "ParentId",
      "CreatedAt",
      "CreatedAtNanos",
      "TenantId"
    ]
  },
  "rollback": {
    "method": "POST",
    "path": "/changes/{id}/rollback",
    "keys": [
      "change",
      "message",
      "rollbackRunId",
      "rolledBackHosts",
      "skippedHosts",
      "success"
    ],
    "forbid": [
      "Change",
      "RollbackRunId",
      "Success",
      "RolledBackHosts",
      "SkippedHosts",
      "Message"
    ]
  },
  "system-status": {
    "method": "GET",
    "path": "/system/status",
    "keys": [
      "status",
      "storeType"
    ],
    "forbid": [
      "Version",
      "Uptime",
      "ActiveRuns"
    ]
  },
  "system-version": {
    "method": "GET",
    "path": "/system/version",
    "keys": [
      "buildDate",
      "gitCommit",
      "goVersion",
      "version"
    ],
    "forbid": [
      "Version",
      "GitCommit",
      "BuildDate",
      "GoVersion"
    ]
  },
  "takeover-events": {
    "method": "GET",
    "path": "/system/takeover-events",
    "keys": [
      "days",
      "events",
      "window_from"
    ],
    "forbid": [
      "Events",
      "Days",
      "WindowFrom"
    ]
  }
}
